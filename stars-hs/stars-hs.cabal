cabal-version: 3.0


name:        stars-hs
version:     0.1.0.0
synopsis:    Haskell implementation of 'stars' test project.
description: Implementation of interactive demo with camera flying through infinite star field. Shares algorithm with C/C++/Rust/... implementations.
author:      TioT2
build-type:  Simple

common warnings
    ghc-options: -Wall

executable stars-hs
    import:           warnings
    main-is:          Main.hs
    -- other-modules:
    -- other-extensions:
    build-depends:    base              ^>= 4.22.0.0
                    , sdl2              ^>= 2.5.5.1
                    , text              ^>= 2.1.4
    hs-source-dirs:   app
    default-language: Haskell2010
